    "reanchor": {
      "value": false,
      "why": "subharmonic re-anchoring: measured zero change in FA and P(d); frame-level octave slip rose 16.9%->17.8%."
    },
    "min_teeth": {
      "value": 0,
      "why": "harmonic-extent gate: no separation against livestock, which saturates at 12/12 supported teeth exactly as drones do. That is why it is off. It is not a general result: a piano is inharmonic (stiff string, partials at n*f0*sqrt(1+B*n^2)) and measures 8/11/12 teeth at p10/median/p90 where every drone class measures 12/12/12, so the same gate at 11 is the veto's second term. Rejected against the wrong adversary; see veto_voice."
    },
    "veto_voice": {
      "value": false,
      "why": "the voice and struck-note veto, calibrated against synthetic piano and held-vowel families. Recalibrated and paired over 486 positives it is 0 lost / 92 gained, McNemar p < 0.0001, and it removes a held vowel entirely."
    },
    "thr_off_prio": {
      "value": 0.0,
      "why": "two-tier band offset: measured no effect - the threat and the binding confuser both sit in the priority band, so any offset is cancelled by threshold recalibration."
    }
